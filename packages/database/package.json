{
  "name": "@fota/database",
  "type": "module",
  "version": "1.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "db:generate": "DEBUG='prisma:config,prisma:client-generator-ts*' prisma generate",
    "db:migrate": "DEBUG='prisma:migrate,prisma:engine' prisma migrate dev",
    "db:reset": "DEBUG='prisma:migrate,prisma:engine' prisma migrate reset",
    "lint": "bunx --bun eslint . --cache",
    "lint:fix": "bunx --bun eslint . --cache --fix"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fota/configs": "workspace:*",
    "@fota/logger": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "find-config": "^1.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@prisma/config": "^7.10.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1"
  }
}
